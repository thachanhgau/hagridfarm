index 0000000000000000000000000000000000000000..72476c0c53e1a9b8c702240a43a46d3781a9f497
--- /dev/null
+++ b/docs/codex-briefs/skills-s2-v2/assemble-sheets.py
@@ -0,0 +1,44 @@
+"""Placement and inspection only; no native icons, quantization or master alpha edits."""
+from pathlib import Path
+from PIL import Image, ImageDraw
+import json
+
+base = Path(__file__).resolve().parent
+root = base.parents[2]
+out = root / 'garden-v05/masters-items/skills-s2-v2'
+out.mkdir(exist_ok=False)
+items = json.loads((base / 'prompts.json').read_text())['items']
+sheets = [Image.new('RGBA', (1536, 1024)) for _ in range(3)]
+qa = Image.new('RGB', (900, 660), '#292631')
+draw = ImageDraw.Draw(qa)
+checks = []
+for i, item in enumerate(items):
+    cell = Image.open(base / (item['id'] + '-cell.png')).convert('RGBA')
+    sheet, within = divmod(i, 6)
+    row, col = divmod(within, 3)
+    sheets[sheet].paste(cell, (col * 512, row * 512))
+    alpha = cell.getchannel('A')
+    bbox = alpha.getbbox()
+    margins = [bbox[0], bbox[1], 512 - bbox[2], 512 - bbox[3]]
+    assert min(margins) >= 40
+    hist = alpha.histogram()
+    checks.append(dict(id=item['id'], sheet=sheet+1, cell=f'r{row+1} c{col+1}',
+        size=list(cell.size), bbox=list(bbox), margins=margins,
+        alphaMin=min(alpha.getdata()), alphaMax=max(alpha.getdata()),
+        alphaBelow192Nonzero=sum(hist[1:192]), alphaAtLeast192=sum(hist[192:]),
+        alpha255=hist[255], cropPolicy='Bounds of alpha >=192, RGBA unchanged inside crop; fit within 420x420 nearest-neighbour'))
+    # Thresholded image exists only in this QA composite, never in the masters.
+    tiny = cell.resize((64,64), Image.Resampling.NEAREST)
+    tiny.putalpha(tiny.getchannel('A').point(lambda a:255 if a>=192 else 0))
+    tiny = tiny.resize((40,40), Image.Resampling.NEAREST)
+    x, y = (i%6)*150, (i//6)*220
+    draw.text((x+5,y+5), item['id'], fill='white')
+    qa.paste(tiny, (x+5,y+30), tiny)
+    big = tiny.resize((120,120), Image.Resampling.NEAREST)
+    qa.paste(big, (x+5,y+80), big)
+for i, sheet in enumerate(sheets, 1):
+    sheet.save(out / f'skills-sheet-{i}.png')
+    assert Image.open(out / f'skills-sheet-{i}.png').size == (1536,1024)
+qa.save(base / 'review-alpha192-40px.png')
+(base / 'verification.json').write_text(json.dumps(dict(cells=checks, sheets=[dict(file=str(out/f'skills-sheet-{i}.png'),size=[1536,1024],mode='RGBA') for i in range(1,4)]), indent=2)+'\n')
+print(json.dumps(dict(cells=len(checks), sheets=3, minimumMargin=min(min(c['margins']) for c in checks), alphaStats=[(c['id'],c['alphaBelow192Nonzero'],c['alphaAtLeast192'],c['alpha255']) for c in checks])))
