+import json, struct, zlib, hashlib, shutil
+from pathlib import Path
+from collections import Counter
+
+def read_png(path):
+    b=Path(path).read_bytes(); pos=8; data=[]
+    while pos<len(b):
+        n=struct.unpack('>I',b[pos:pos+4])[0]; t=b[pos+4:pos+8]; v=b[pos+8:pos+8+n]; pos+=n+12
+        if t==b'IHDR':
+            w,h,depth,kind,comp,filt,inter=struct.unpack('>IIBBBBB',v)
+            assert (depth,kind,comp,filt,inter)==(8,6,0,0,0)
+        if t==b'IDAT': data.append(v)
+    raw=zlib.decompress(b''.join(data)); rows=[]; prev=bytearray(w*4); stride=w*4
+    for y in range(h):
+        start=y*(stride+1); ft=raw[start]; row=bytearray(raw[start+1:start+1+stride])
+        for x in range(stride):
+            a=row[x-4] if x>=4 else 0; bb=prev[x]; c=prev[x-4] if x>=4 else 0
+            if ft==1: v=a
+            elif ft==2: v=bb
+            elif ft==3: v=(a+bb)//2
+            elif ft==4:
+                p=a+bb-c; pa=abs(p-a); pb=abs(p-bb); pc=abs(p-c)
+                v=a if pa<=pb and pa<=pc else bb if pb<=pc else c
+            else: assert ft==0; v=0
+            row[x]=(row[x]+v)&255
+        rows.append(row); prev=row
+    return w,h,rows
+
+records=json.loads(Path('/private/tmp/floo-s2-attempts.json').read_text())
+palette={tuple(bytes.fromhex(c)) for c in '231F2E 4A3042 735044 A57554 41465C 687486 A6B1AE D6D8BF 24483F 3F6A45 71934B B0BD67 8B4A3F C97952 E7AE73 F5D69A 874056 C75B4B ED8A45 FFC36B 3E3B70 6961A6 70A8B6 B7DEE0'.split()}
+for r in records:
+    w,h,rows=read_png(r['source']); alpha=Counter(); visible=set(); cells=[]; uniform=0
+    for y in range(0,h,16):
+        for x in range(0,w,16):
+            square=rows[y][x*4:(x+1)*4]*16
+            uniform+=all(row[x*4:(x+16)*4]==square for row in rows[y:y+16])
+    for i in range(6):
+        x0=(i%3)*512; y0=(i//3)*512; coords=[]; colors=set()
+        for y in range(512):
+            row=rows[y0+y]
+            for x in range(512):
+                off=(x0+x)*4; rr,gg,bb,aa=row[off:off+4]; alpha[aa]+=1
+                if aa: coords.append((x,y)); colors.add((rr,gg,bb))
+        visible.update(colors)
+        bbox=[min(x for x,y in coords),min(y for x,y in coords),max(x for x,y in coords)+1,max(y for x,y in coords)+1] if coords else None
+        cells.append({'bbox_alpha_gt_0':bbox,'visible_colors':len(colors),'nontransparent_pixels':len(coords)})
+    r['sha256']=hashlib.sha256(Path(r['source']).read_bytes()).hexdigest()
+    r['inspection']={'size':[w,h],'alpha_range':[min(alpha),max(alpha)],'transparent_pixels':alpha[0],'opaque_pixels':alpha[255],'semitransparent_pixels':sum(n for a,n in alpha.items() if 0<a<255),'visible_colors':len(visible),'off_palette_colors':len(visible-palette),'uniform_16px_blocks':uniform,'total_blocks':w*h//256,'cells':cells}
+    r['acceptance']='Fails strict grid/palette/alpha requirements; unmodified generated candidate only, not approved native art.'
+    if r['selected']:
+        dest=Path(r['destination']); assert not dest.exists(); shutil.copyfile(r['source'],dest)
+        assert hashlib.sha256(dest.read_bytes()).hexdigest()==r['sha256']
+    print(r['sheet'],r['candidate'],r['selected'],json.dumps({k:v for k,v in r['inspection'].items() if k!='cells'}),flush=True)
+manifest=Path('garden-v05/environment/floo-frames/prompts.json'); old=json.loads(manifest.read_text()); assert len(old)==4
+manifest.write_text(json.dumps(old+records,ensure_ascii=False,indent=2)+'\n')
+Path('/private/tmp/floo-s2-inspected.json').write_text(json.dumps(records,indent=2))

